<odoo>

    <record id="property_offer_tree" model="ir.ui.view">
        <field name="name">Offers Tree</field>
        <field name="model">property.offer</field>
        <field name="arch" type="xml">
            <list>
                <field name="id" />
                <field name="price" />
                <field name="status" />
                <field name="partner_id" />
                <field name="property_id" />
                <field name="validity" />
                <field name="date_deadline" />
            </list>
        </field>
    </record>

    <record id="property_offer_form" model="ir.ui.view" >
        <field name="name">Offers Form</field>
        <field name="model">property.offer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar" options="{'clickable': True}"/>

                    <button name="archive_records" string="Archive Records" type="object" class="btn-primary"/>
                    <button name="unarchive_records" string="UnArchive Records" type="object" class="btn-primary"/>
                    <button name="action_accept" string="Accept" type="object" class="btn-success"/>
                </header>
                <sheet>
                    <group>
                        <field name="price" />
                        <field name="status" />
                        <field name="partner_id" />
                        <field name="property_id" />
                        <field name="validity" />
                        <field name="date_deadline" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="property_offer_action_window" model="ir.actions.act_window">
        <field name="name">Property Offers</field>
        <field name="res_model">property.offer</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="property_offer_menu"
        name="Offers"
        parent="configuration_menu"
        action="property_offer_action_window"
    />

</odoo>
