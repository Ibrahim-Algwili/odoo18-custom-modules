<odoo>

    <record id="xlsx_property_wizard_view_form" model="ir.ui.view">
        <field name="name">xlsx.property.wizard.view.form</field>
        <field name="model">xlsx.property.wizard</field>
        <field name="arch" type="xml">
            <form string="Form Title">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="property_ids" widget="many2many_tags" required="1"/>
                        </h1>
                    </div>
                    <footer>
                        <button name="action_download_xlsx_report" type="object" string="Download" class="btn-primary"/>
                        <button special="cancel" string="Cancel" class="btn-secondary "/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="xlsx_property_wizard_action" model="ir.actions.act_window">
        <field name="name">xlsx.property.wizard.action</field>
        <field name="res_model">xlsx.property.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="app_one.xlsx_property_wizard_view_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="xlsx_property_menu" name="Xlsx Property Wizard" parent="real_estate_root_menu" action="xlsx_property_wizard_action" sequence="10" />


</odoo>
