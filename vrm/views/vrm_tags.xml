<odoo>

    <!-- List View -->
    <record id="view_vrm_vendor_tag_list" model="ir.ui.view">
        <field name="name">vrm.vendor.tag.list</field>
        <field name="model">vrm.vendor.tag</field>
        <field name="arch" type="xml">
            <list string="VRM Tags" editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_vrm_tags" model="ir.actions.act_window">
        <field name="name">VRM Tags</field>
        <field name="res_model">vrm.vendor.tag</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Create your first VRM Tag
            </p>
        </field>
    </record>

</odoo>