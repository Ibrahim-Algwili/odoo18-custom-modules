<odoo>

    <!-- Kanban view -->
    <record id="view_vrm_vendor_lead_kanban" model="ir.ui.view">
        <field name="name">vrm.vendor.lead.kanban</field>
        <field name="model">vrm.vendor.lead</field>
        <field name="arch" type="xml">

            <kanban
                    default_group_by="vrm_stage_id"
                    class="o_kanban_view"
                    create="true"
                    quick_create="true"
            >
                <!-- Progress Bar on top of kanban -->
                <div class="oe_kanban_bottom_right">
                    <div class="o_kanban_record_progress">
                        <field name="activity_state" invisible="1"/>

                        <progressbar field="activity_state"
                                     colors='{"planned": "success", "today": "warning", "overdue": "danger"}'
                                     sum_field="expected_annual_spend"/>
                    </div>
                </div>

                <!-- Necessory to show columns -->
                <group>
                    <field name="vrm_stage_id" domain="[]" context="{'group_by': 'vrm_stage_id'}"/>
                </group>

                <field name="vrm_stage_id" group_create="true"/>
                <field name="responsible_id" widget="many2one_avatar"/>
                <field name="vrm_tier"/>
                <field name="vrm_risk"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_next_action"/>
                <field name="is_approved"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click"
                             style="border-left: 4px solid #6c63ff; padding:10px; margin:5px;">

                            <div>
                                <strong>
                                    <field name="name"/>
                                </strong>
                            </div>

                            <div t-if="record.partner_id.raw_value">
                                Vendor:
                                <field name="partner_id" widget="many2one_avatar"/>
                            </div>

                            <div>
                                Expected Spend:
                                <field name="expected_annual_spend"/> <span><field name="currency_id"/></span>
                            </div>

                            <div>
                                Tier:
                                <field name="vrm_tier"/>
                            </div>

                            <div>
                                Risk:
                                <field name="vrm_risk" widget="priority"/>
                            </div>

                            <div t-if="record.responsible_id.raw_value" style="margin-top:5px;">
                                Owner:
                                <field name="responsible_id" widget="many2one_avatar"/>
                            </div>

                            <div t-if="record.date_next_action.raw_value">
                                Next:
                                <field name="date_next_action"/>
                            </div>

                            <div t-if="record.is_approved.raw_value" style="margin-top:5px;">
                                <strong style="color:green;">Approved</strong>
                            </div>

                            <div>
                                <field name="vrm_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            </div>

                            <!-- Activity -->
                            <div class="oe_kanban_bottom_right">
                                <field name="activity_ids" widget="list_activity"/>
                            </div>

                        </div>
                    </t>
                </templates>
            </kanban>

        </field>
    </record>


    <!-- Form view -->
    <record id="view_vrm_vendor_lead_form" model="ir.ui.view">
        <field name="name">vrm.vendor.lead.form</field>
        <field name="model">vrm.vendor.lead</field>
        <field name="arch" type="xml">
            <form string="VRM Lead">
                <sheet>
                    <!-- Stage Statusbar -->
                    <header>

                        <!-- Buttons -->
                        <button name="action_won_lead" string="Won" type="object" class="btn-success"/>
                        <button name="action_rfq" string="RFQ" type="object" class="btn-primary"/>


                        <!-- Widgets-->
                        <!--                        <widget name="web_ribbon" title="Won" bg_color="text-bg-success"-->
                        <!--                            invisible="is_won"/>-->


                        <field name="vrm_stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                    </header>

                    <!-- Vendor Lead Name -->
                    <div>
                        <label for="name" string="Vendor Lead: "/>
                        <h1 class="o_form_title o_form_editable">
                            <field name="name" placeholder="New Vendor Lead"/>
                        </h1>
                    </div>

                    <!-- Expected Annual Spend and Probability -->
                    <div class="o_row" style="align-items: flex-start; gap: 40px;">
                        <div>
                            <label for="expected_annual_spend" string="Expected Spend ?" class="text-muted"/>
                            <h2 class="mt0">
                                <field name="expected_annual_spend" nolabel="1"/>
                            </h2>
                        </div>

                        <div>
                            <label for="probability" string="Probability ?" class="text-muted"/>

                            <h2 class="mt0 o_row" style="align-items: baseline;">
                                <span class="text-muted mr-1" style="font-size: 0.8em; font-weight: normal;">at</span>
                                <field name="probability" nolabel="1"/>
                                <span>%</span>
                            </h2>
                        </div>
                    </div>

                    <!-- Main Information Groups -->
                    <group>

                        <group>
                            <field name="partner_id" widget="many2one_avatar"/>
                            <field name="purchase_team_id" widget="many2one_avatar"/>
                            <field name="responsible_id" widget="many2one_avatar" />
                        </group>

                        <group>
                            <field name="currency_id"/>
                            <field name="vrm_tier"/>
                            <field name="vrm_risk" widget="priority"/>
                        </group>

                    </group>

                    <!-- Tags -->
                    <group>
                        <field name="vrm_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    </group>

                    <notebook>

                        <page string="Notes">
                            <field name="note"/>
                        </page>

                        <page string="Activities">
                            <field name="activity_ids" nolabel="1"/>
                        </page>

                        <!-- Vendor Details -->
                        <page string="Extra Information">
                            <group string="Vendor Details">
                                <field name="vendor_street"/>
                                <field name="vendor_phone"/>
                                <field name="vendor_email"/>
                                <field name="vendor_country_id"/>
                                <field name="vendor_vat"/>
                                <field name="vendor_website"/>
                                <!--                                <field name="vendor_purchase_team" readonly="1"/>-->
                            </group>
                        </page>

                    </notebook>

                </sheet>
                <!-- Chatter -->
                <chatter>
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                    <field name="activity_ids" widget="mail_activity"/>
                </chatter>
            </form>
        </field>
    </record>

    <!-- List (list) view -->
    <record id="view_vrm_vendor_lead_list" model="ir.ui.view">
        <field name="name">vrm.vendor.lead.list</field>
        <field name="model">vrm.vendor.lead</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="vrm_stage_id"/>
                <field name="responsible_id"/>
                <field name="is_approved"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_vrm_vendors_filter" model="ir.ui.view">
        <field name="name">vrm.vendor.search.lead</field>
        <field name="model">vrm.vendor.lead</field>
        <field name="arch" type="xml">
            <search string="Search Leads">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="responsible_id"/>

                <!-- Filters -->
                <filter name="my_leads" string="My Leads" domain="[('responsible_id', '=', uid)]"/>
                <!--                <filter name="approved_leads" string="Approved Leads" domain="[('is_approved', '=', True)]"/>-->
                <!--                <filter name="not_approved_leads" string="Not Approved Leads" domain="[('is_approved', '=', False)]"/>-->
            </search>
        </field>
    </record>

    <!-- Server Actions -->
    <record id="server_action_suspend_vendor_lead" model="ir.actions.server">
        <field name="name">Suspend Vendor Lead</field>
        <field name="model_id" ref="model_vrm_vendor_lead"/>
        <field name="state">code</field>
        <field name="code">
            records.action_suspend_lead_direct()
        </field>
    </record>

    <!-- Action to open the vendor leads -->
    <record id="action_vrm_pipeline" model="ir.actions.act_window">
        <field name="name">Vendor Pipeline</field>
        <field name="res_model">vrm.vendor.lead</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'group_by':'vrm_stage_id'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first vendor lead
            </p>
        </field>
    </record>
</odoo>