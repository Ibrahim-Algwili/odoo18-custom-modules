<odoo>

    <!-- Purchase Team list view -->
    <record id="view_purchase_team_list_vrm" model="ir.ui.view">
        <field name="name">purchase.team.list.vrm</field>
        <field name="model">purchase.team</field>
        <field name="arch" type="xml">
            <list string="Purchase Teams" editable="bottom">
                <field name="name"/>
                <field name="manager_id" widget="many2one_avatar"/>
                <field name="user_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- Purchase Team Window Action -->
    <record id="action_purchase_team_vrm" model="ir.actions.act_window">
        <field name="name">Purchase Teams</field>
        <field name="res_model">purchase.team</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first purchase team
            </p>
        </field>
    </record>

</odoo>