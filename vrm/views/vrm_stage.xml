<odoo>

    <!-- List View -->
    <record id="view_vrm_stage_tree" model="ir.ui.view">
        <field name="name">vrm.stage.tree</field>
        <field name="model">vrm.vendor.stage</field>
        <field name="arch" type="xml">
            <list string="VRM Stages" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="folded"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_vrm_stages" model="ir.actions.act_window">
        <field name="name">VRM Stages</field>
        <field name="res_model">vrm.vendor.stage</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Create your first VRM Stage
            </p>
        </field>
    </record>

</odoo>