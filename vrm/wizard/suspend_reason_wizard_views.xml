<odoo>

    <!-- Wizard View for Suspend Reason -->
    <record id="view_suspend_reason_wizard_form" model="ir.ui.view">
        <field name="name">suspend.reason.wizard.form</field>
        <field name="model">suspend.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Suspend Vendor Lead">
                <group>
                    <field name="name" placeholder="Enter the reason for suspension..." nolabel="1"/>
                    <field name="suspend_feedback" placeholder="Additional feedback (optional)" nolabel="1"/>
                </group>
                <footer>
                    <button string="Confirm" type="object" name="action_suspend_reason_apply" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>


    <!-- Action to open the Suspend Reason Wizard -->
    <record id="action_suspend_reason_wizard" model="ir.actions.act_window">
            <field name="name">Suspend Vendor Lead</field>
            <field name="res_model">suspend.reason.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_suspend_reason_wizard_form"/>
            <field name="target">new</field>
    </record>
</odoo>