    <!-- Leave it For Now -->

    <!-- Stages Record Rule -->
    <record id="rule_vrm_vendor_stage_all" model="ir.rule">
        <!-- Everyone can see all stages -->
        <field name="name">VRM Vendor Stages: visible to all</field>
        <field name="model_id" ref="vrm.model_vrm_vendor_stage"/>
        <!-- No group = applies to everyone -->
        <field name="domain_force">[(1,'=',1)]</field>
    </record>


    <!-- Tags Record Rules -->
    <record id="rule_vrm_vendor_tag_all" model="ir.rule">
        <field name="name">VRM Vendor Tags: visible to all</field>
        <field name="model_id" ref="vrm.model_vrm_vendor_tag"/>
        <!-- Allow everyone to see all tags -->
        <field name="domain_force">[(1,'=',1)]</field>
    </record>


</odoo>