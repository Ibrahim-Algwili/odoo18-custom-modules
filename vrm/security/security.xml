<odoo>

    <!-- Category -->
    <record id="purchase_team_category" model="ir.module.category">
        <field name="name">VRM</field>
    </record>

    <!-- Groups -->
    <record id="group_vrm_user" model="res.groups">
        <field name="name">VRM User</field>
        <field name="category_id" ref="vrm.purchase_team_category"/>
    </record>

    <record id="group_vrm_manager" model="res.groups">
        <field name="name">VRM Manager</field>
        <field name="implied_ids"
               eval="[(4, ref('group_vrm_user'))]"/> <!-- To inherit the access rights of the user -->
        <field name="category_id" ref="vrm.purchase_team_category"/>
    </record>


    <!-- Record Rules -->


    <record id="rule_vrm_leads_user" model="ir.rule">
        <field name="name">VRM Leads: only my leads (users)</field>
        <field name="model_id" ref="vrm.model_vrm_vendor_lead"/>
        <!-- This rule applies ONLY to users in Purchase Team User group -->
        <field name="groups" eval="[(4, ref('vrm.group_vrm_user'))]"/>
        <!--
            Domain logic:
            A user can see a lead IF:
            - He is the responsible user of the lead
            OR
            - He is the creator of the lead
        -->
        <field name="domain_force">[
            '|',
            ('responsible_id','=',user.id),
            ('create_uid','=', user.id)
            ]
        </field>

    </record>


    <record id="rule_vrm_leads_manager" model="ir.rule">
        <field name="name">VRM Leads: for team managers</field>
        <field name="model_id" ref="vrm.model_vrm_vendor_lead"/>
        <!-- This rule applies ONLY to users in Purchase Team Manager group -->
        <field name="groups" eval="[(4, ref('vrm.group_vrm_manager'))]"/>
        <!--
            Domain logic:
            A manager can see a lead IF:
            - The lead belongs to one of the teams he manages
            OR
            - The lead Has No Team
            OR
            - He is personally responsible for the lead
            OR
            - He is the creator of the lead
        -->
        <field name="domain_force">[
            '|', '|', '|',
            ('purchase_team_id', 'in', user.purchase_team_manager_ids.ids),
            ('purchase_team_id', '=', False),
            ('responsible_id', '=', user.id),
            ('create_uid', '=', user.id)
            ]
        </field>
    </record>

