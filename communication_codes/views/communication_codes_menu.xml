<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_communication_codes" model="ir.actions.act_window">
        <field name="name">إدارة شفرات الاتصالات</field>
        <field name="res_model">communication.codes</field>
        <field name="view_mode">list,kanban,graph,pivot,form</field>
        <field name="context">{'search_default_group_employee': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                قم بإنشاء أول شفرة اتصال
            </p>
        </field>
    </record>

    <record id="action_import_communication_codes" model="ir.actions.act_window">
        <field name="name">استيراد من Excel</field>
        <field name="res_model">import.communication.codes.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_export_communication_codes" model="ir.actions.act_window">
        <field name="name">تصدير إلى Excel</field>
        <field name="res_model">export.communication.codes.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_communication_root"
              name="الاتصالات"
              sequence="100"/>

    <menuitem id="menu_communication_dashboard"
              name="لوحة البيانات"
              parent="menu_communication_root"
              action="communication_codes.action_communication_dashboard"
              sequence="0"/>

    <menuitem id="menu_communication_codes"
              name="إدارة شفرات الاتصالات"
              parent="menu_communication_root"
              action="communication_codes.action_communication_codes"
              sequence="1"/>

    <menuitem id="menu_import_communication_codes"
              name="استيراد من Excel"
              parent="menu_communication_root"
              action="communication_codes.action_import_communication_codes"
              sequence="2"/>

    <menuitem id="menu_export_communication_codes"
              name="تصدير إلى Excel"
              parent="menu_communication_root"
              action="communication_codes.action_export_communication_codes"
              sequence="3"/>
</odoo>
