<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_import_communication_codes_wizard" model="ir.ui.view">
        <field name="name">import.communication.codes.wizard.form</field>
        <field name="model">import.communication.codes.wizard</field>
        <field name="arch" type="xml">
            <form string="استيراد من Excel">
                <group>
                    <group>
                        <field name="file" filename="filename" string="اختر ملف Excel"/>
                        <field name="filename" invisible="1"/>
                    </group>
                    <group>
                        <field name="import_mode" string="وضع الاستيراد"/>
                    </group>
                </group>

                <group invisible="state != 'done'">
                    <group>
                        <field name="state" invisible="1"/>
                        <field name="success_count" string="السجلات الناجحة" readonly="1"/>
                        <field name="error_count" string="السجلات الفاشلة" readonly="1"/>
                    </group>
                    <group>
                        <field name="error_lines" string="سجل الأخطاء" readonly="1"
                               widget="text" height="200"/>
                    </group>
                </group>

                <footer>
                    <button name="action_import" string="استيراد" type="object"
                            class="oe_highlight" invisible="state == 'done'"/>
                    <button name="action_reset" string="إعادة تعيين" type="object"
                            invisible="state == 'draft'"/>
                    <button string="إغلاق" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
