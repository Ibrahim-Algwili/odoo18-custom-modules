<odoo>

    <template id="sale_order_copy_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">

                    <!-- Sale Order Sequence -->
                    <div class="page">
                        <h1>Order:
                            #
                            <t t-esc="o.name"/>
                        </h1>
                    </div>

                    <!-- Header -->
                    <div class="row">
                        <div class="col-6">
                            <h6>
                                <strong>Order Date:</strong>
                                <br/>
                                <t t-esc="o.date_order"/>
                            </h6>
                        </div>

                        <div class="col-6">
                            <h6>
                                <strong>Sales Person</strong>
                                <br/>
                                <t t-esc="o.user_id.name"/>
                            </h6>
                        </div>
                    </div>

                    <table class="table borderless:True">
                        <thead>
                            <tr>
                                <th>
                                    <strong>Description</strong>
                                </th>
                                <th>
                                    <strong>Quantity</strong>
                                </th>
                                <th>
                                    <strong>Unit Price</strong>
                                </th>
                                <th>
                                    <strong>Taxes</strong>
                                </th>
                                <th>
                                    <strong>Amount</strong>
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            <t t-foreach="o.order_line" t-as="line">
                                <tr>
                                    <td>
                                        <span t-field="line.product_template_id.display_name"/>
                                    </td>
                                    <td>
                                        <span t-field="line.product_uom_qty"/>
                                    </td>
                                    <td>
                                        <span t-field="line.price_unit"/>
                                    </td>
                                    <td>
                                        <span t-out="', '.join(map(lambda x: (x.description or x.name), line.tax_id))"/>
                                    </td>
                                    <td>
                                        <span t-field="line.price_subtotal"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>

                    </table>

                    <!-- Amount -->
                    <div class="clearfix" name="so_total_summary">
                        <div id="total" class="row" name="total">
                            <div class="col-4 ms-auto" style="width: 45%; float: right;">
                                <table class="table table-sm table-borderless" style="page-break-inside: avoid;">
                                    <tr class="border-black" style="border-top: 1px solid black !important;">
                                        <td name="td_amount_untaxed_label">
                                            <strong>Untaxed Amount</strong>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="o.amount_untaxed"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>

                                    <tr class="border-black" style="border-top: 1px solid black !important;">
                                        <td name="td_amount_total_label">
                                            <strong>Total</strong>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="o.amount_total" class="text-nowrap"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>

                    <hr/>
                    <br/>
                    <br/>
                    <br/>

                    <!-- new features -->
                    <div class="row">
                        <div class="col-6">
                            <span style="font-size: 30px;"> <b> Signature : ............................. </b> </span>
                        </div>
                        <div class="col-6">
                            <spna style="font-size: 30px;"> <b> Receiver : ............................. </b> </spna>
                        </div>
                    </div>

                </t>
            </t>
        </t>
    </template>

</odoo>
